# Copiază în .env (implicit) sau .env.<proiect> și pornește cu: node server.js --env .env.<proiect>
# Obligatoriu: folderul care conține rapoartele Playwright
REPORTS_BASE_PATH=C:\path\to\reports
# Opționale (valorile implicite sunt cele de mai jos)
PORT=3000
PROJECT_NAME=Playwright Report Viewer
FOLDER_PREFIX=playwright-report-
# Temă (opțional): culoarea principală pentru fundal + butoane; nuanța închisă se calculează dacă lipsește
PRIMARY_COLOR=#1d8187
PRIMARY_COLOR_DARK=#045a63
# Favicon (opțional): cale absolută sau relativă la folderul viewer-ului, ex. favicons\proiect.ico
FAVICON_PATH=
